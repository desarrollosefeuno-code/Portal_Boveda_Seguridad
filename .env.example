# ─────────────────────────────────────────────────────────────────────────────
# F1 KeyVault — variables de entorno
# Copia este archivo a .env y reemplaza TODOS los valores. El servidor no arranca
# si falta un secreto, si es corto o si es uno de los publicados en versiones anteriores.
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# Railway inyecta PORT automáticamente
PORT=3001

# PostgreSQL. En Railway: ${{Postgres.DATABASE_URL}} (o la URL privada *.railway.internal)
DATABASE_URL=postgresql://usuario:clave@host:5432/portal_boveda

# TLS hacia PostgreSQL: verify (por defecto, valida el certificado), no-verify (solo si el proveedor
# usa un certificado autofirmado y no tienes su CA) o disable. En la red privada *.railway.internal
# y en localhost se usa sin TLS salvo que la URL diga sslmode=require.
# DATABASE_SSL=verify
# CA del proveedor en PEM (con \n en una sola línea) para validar un certificado propio
# DATABASE_SSL_CA=

# Clave maestra de cifrado (mínimo 32 caracteres). Si se pierde, los secretos guardados NO se pueden recuperar:
# respáldala fuera de Railway (gestor de contraseñas de la gerencia, sobre sellado, etc.).
MASTER_ENCRYPTION_KEY=reemplazar-por-un-valor-aleatorio-de-48-bytes
# Solo durante una rotación: la clave anterior. Al arrancar, todo se re-cifra con la nueva; luego se borra.
# MASTER_ENCRYPTION_KEY_PREVIOUS=

# Secreto de firma de sesiones y del token de bóveda (mínimo 32 caracteres, distinto de la clave maestra)
JWT_SECRET=reemplazar-por-otro-valor-aleatorio-de-48-bytes

# Orígenes adicionales que pueden llamar al API con credenciales (separados por coma). Vacío = solo el propio dominio.
# CORS_ORIGINS=

# Saltos de proxy de confianza para obtener la IP real (Railway: 1). Por defecto 1 en producción.
# TRUST_PROXY=1

# Primer administrador: se usa SOLO si la base no tiene usuarios. La contraseña debe tener 14+ caracteres;
# deberá cambiarse en el primer ingreso. Bórralas de Railway después del primer arranque.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_NAME=Administrador de Seguridad F1
