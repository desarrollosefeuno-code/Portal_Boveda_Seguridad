# Puerto del servidor (Railway inyecta $PORT automáticamente)
PORT=3001
NODE_ENV=production

# Base de datos PostgreSQL (Railway Postgres plugin inyecta DATABASE_URL automáticamente)
# Formato: postgresql://postgres:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/portal_boveda

# Llave Maestra de Cifrado AES-256-GCM (Hex de 32 o 64 caracteres, o frase ultra-segura)
MASTER_ENCRYPTION_KEY=f1_fortress_master_secret_aes_256_gcm_ultra_secure_2026_key

# Secreto para firma de JWT de sesiones de usuario (mínimo 32 caracteres)
JWT_SECRET=f1_keyvault_jwt_session_signing_secret_super_long_32chars_minimum

# Credenciales de Administrador Inicial (creado automáticamente al iniciar si la BD está vacía)
DEFAULT_ADMIN_EMAIL=admin@f1.services
DEFAULT_ADMIN_PASSWORD=AdminFortress2026!
DEFAULT_ADMIN_NAME=Administrador de Seguridad F1

# Clave PIN de 4 dígitos inicial para desbloqueo verbal de la bóveda
DEFAULT_VAULT_PIN=1234

